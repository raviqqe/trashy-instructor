{
	"private": true,
	"name": "trashy-instructor",
	"version": "0.1.0",
	"scripts": {
		"build": "webpack-cli",
		"test": "jest --coverage",
		"lint": "tslint -c tslint.json -p tsconfig.json",
		"watch": "webpack-cli --watch",
		"start": "npm run build && electron ./dist/main.js"
	},
	"devDependencies": {
		"@types/enzyme": "^3.1.11",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.14.110",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^16.0.6",
		"electron": "^39.8.5",
		"enzyme": "^3.3.0",
		"enzyme-adapter-react-16": "^1.15.8",
		"jest": "^30.4.2",
		"lodash": "^4.18.1",
		"react": "^19.2.8",
		"react-dom": "^16.14.0",
		"react-icons": "^2.2.7",
		"react-redux": "^5.0.7",
		"redux": "^4.0.0",
		"redux-thunk": "^2.3.0",
		"styled-components": "^6.4.4",
		"ts-jest": "^29.4.12",
		"ts-loader": "^9.6.2",
		"tslint": "^5.10.0",
		"tslint-config-prettier": "^1.13.0",
		"tslint-react": "^3.6.0",
		"typescript": "^2.9.2",
		"typescript-fsa": "^3.0.0-beta-2",
		"typescript-fsa-reducers": "^0.4.5",
		"webpack": "^5.109.2",
		"webpack-cli": "^7.2.2"
	},
	"jest": {
		"moduleFileExtensions": [
			"ts",
			"tsx",
			"js"
		],
		"setupTestFrameworkScriptFile": "./src/test-setup.ts",
		"testRegex": "/__tests__/.*\\.tsx?",
		"transform": {
			"^.+\\.(ts|tsx)$": "ts-jest"
		}
	}
}
